<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup and device-to-device transfer. Only the user's own progress travels:
    the app database and its settings. Purchase caches are re-read from Google Play, and
    Firebase / AdMob files stay out so two devices never share one installation id.
    Keep in sync with backup_rules.xml (Android 8-11).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="focus_farm_db" />
        <include domain="database" path="focus_farm_db-wal" />
        <include domain="database" path="focus_farm_db-shm" />
        <include domain="sharedpref" path="product_onboarding.xml" />
        <include domain="sharedpref" path="garden_preferences.xml" />
        <include domain="sharedpref" path="focus_reminders.xml" />
        <include domain="sharedpref" path="retention_cohort.xml" />
        <include domain="sharedpref" path="local_first_week_cohort.xml" />
        <include domain="sharedpref" path="focusfarm_review_prompt.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="focus_farm_db" />
        <include domain="database" path="focus_farm_db-wal" />
        <include domain="database" path="focus_farm_db-shm" />
        <include domain="sharedpref" path="product_onboarding.xml" />
        <include domain="sharedpref" path="garden_preferences.xml" />
        <include domain="sharedpref" path="focus_reminders.xml" />
        <include domain="sharedpref" path="retention_cohort.xml" />
        <include domain="sharedpref" path="local_first_week_cohort.xml" />
        <include domain="sharedpref" path="focusfarm_review_prompt.xml" />
    </device-transfer>
</data-extraction-rules>
